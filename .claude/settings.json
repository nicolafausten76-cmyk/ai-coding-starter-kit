{
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Read(**/.env)",
      "Read(**/.env[a-z0-9_-]*)",
      "Read(**/.env.[a-df-km-z0-9_-]*)",
      "Read(**/.env.e[a-wyz0-9_-]*)",
      "Read(**/.env.l[a-np-z0-9_-]*)",
      "Read(**/.env.local)",
      "Read(**/.env.local[a-z0-9_-]*)",
      "Read(**/.env.local.[a-df-z0-9_-]*)",
      "Read(**/.env.*.local)",
      "Read(**/.dev.vars*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/secrets/**)",
      "Read(**/credentials/**)",
      "Read(**/.aws/**)",
      "Read(**/.ssh/**)",
      "Read(**/config/database.yml)",
      "Read(**/config/credentials.json)",
      "Read(**/.npmrc)",
      "Read(**/.pypirc)",
      "Edit(**/.env)",
      "Edit(**/.env[a-z0-9_-]*)",
      "Edit(**/.env.[a-df-km-z0-9_-]*)",
      "Edit(**/.env.e[a-wyz0-9_-]*)",
      "Edit(**/.env.l[a-np-z0-9_-]*)",
      "Edit(**/.env.local)",
      "Edit(**/.env.local[a-z0-9_-]*)",
      "Edit(**/.env.local.[a-df-z0-9_-]*)",
      "Edit(**/.env.*.local)",
      "Edit(**/secrets/**)",
      "Edit(**/.ssh/**)"
    ],
    "allow": [
      "Bash(npm install)",
      "Bash(npm run dev:*)",
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run start:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git tag:*)",
      "Bash(git log:*)",
      "Bash(git ls-files:*)",
      "Bash(lsof:*)",
      "Bash(kill:*)",
      "Bash(npx shadcn@latest add:*)",
      "Bash(ls:*)"
    ]
  }
}
